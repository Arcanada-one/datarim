[Unit]
Description=TALO-0001 workflow-scoped GitHub Actions runner
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=talo-replay
Group=talo-replay
SupplementaryGroups=docker
WorkingDirectory=/srv/talo-0001-trusted/runner
ExecStart=/srv/talo-0001-trusted/runner/run.sh
Restart=always
RestartSec=15
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=5min
OOMPolicy=continue
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/talo-0001-trusted/knowledge
ReadWritePaths=/srv/talo-0001-trusted/runner
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
MemoryMax=8G
TasksMax=512

[Install]
WantedBy=multi-user.target
