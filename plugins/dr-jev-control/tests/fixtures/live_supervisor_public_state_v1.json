{
  "schema": "jev.live_supervisor.public_state.v1",
  "title": "Frozen public-state cohort for live supervisor decide/SwitchGate/runtimes",
  "audit_finding": "G-SUPERVISOR-COVERAGE",
  "shadow_only": true,
  "notes": [
    "Offline, secret-free, deterministic. Does not prove a live runtime model switch.",
    "Does not rewrite test_supervisor_e2e.py (e2e base).",
    "Primary routing/pretool cohorts remain separate denominators."
  ],
  "default_cfg": {
    "live": {
      "enabled": true,
      "escalate_threshold": 0.75,
      "deescalate_threshold": 0.85,
      "min_tokens_between_switches": 25000,
      "min_seconds_between_switches": 90,
      "max_switches_per_session": 6,
      "turns_between_reroutes": 2,
      "effort_switching": true,
      "model_ceiling": {
        "economy": "sonnet",
        "balanced": "opus",
        "quality": "opus"
      },
      "model_floor": {
        "economy": "haiku",
        "balanced": "haiku",
        "quality": "sonnet"
      }
    },
    "routing": {},
    "telemetry": {
      "enabled": false
    }
  },
  "cases": [
    {
      "id": "RQ-01-keys",
      "family": "reroute_questions",
      "expect": {
        "keys": ["needed_tier", "is_stuck", "work_simplified", "needs_more_thinking"],
        "types": {
          "needed_tier": "choice",
          "is_stuck": "noul",
          "work_simplified": "noul",
          "needs_more_thinking": "noul"
        },
        "forbidden_substrings_in_keys": ["skill", "agent", "template", "command"]
      }
    },
    {
      "id": "DIR-01-stuck-reinforces-escalate",
      "family": "decide",
      "gate": {"mode": "balanced", "tier": "sonnet", "now": 0.0},
      "observer": {"tools": ["Edit"], "tokens": 80000},
      "answers": {
        "needed_tier": {"choice": "opus", "confidence": 0.30},
        "is_stuck": {"noul": 0.90},
        "work_simplified": {"noul": 0.0},
        "needs_more_thinking": {"noul": 0.0}
      },
      "decide_kwargs": {"turn": 4, "now": 1000.0, "token_hysteresis": true},
      "expect": {
        "switch": true,
        "to": "opus",
        "blocked_by": null,
        "reason_contains": ["stuck"],
        "effort": null
      }
    },
    {
