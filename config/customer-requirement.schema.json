{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datarim.club/schema/customer-requirement-v1.json",
  "title": "Datarim Customer Requirements",
  "description": "Atomic, stable customer requirements with verbatim provenance and a pre-implementation acceptance tuple.",
  "x-datarim-semantic-invariants": {
    "description": "Draft 2020-12 validates shape only; the deterministic customer-delivery validator must enforce every registered cross-record invariant.",
    "enforcer": "customer-delivery-validator",
    "invariant_ids": [
      "source-id-unique",
      "assertion-id-unique",
      "source-requirement-bidirectional",
      "source-assertion-bidirectional",
      "source-quote-set-exact",
      "source-canonical-digest-valid",
      "source-approval-digest-equals-source-digest",
      "source-approval-payload-canonical-digest-valid",
      "source-signature-valid",
      "source-signature-over-approval-payload-digest-valid",
      "assertion-source-digest-equals-containing-source-digest",
      "source-correction-superseded-digest-exists",
      "source-correction-prior-record-retained",
      "source-correction-in-place-replacement-prohibited",
      "source-history-prior-digest-set-retained",
      "source-history-prior-record-content-immutable",
      "source-correction-appended-record-supersedes-prior-digest",
      "tier1-assertion-canonical-digest-valid",
      "tier1-assertion-approval-digest-equals-assertion-digest",
      "tier1-assertion-approval-payload-canonical-digest-valid",
      "tier1-assertion-signature-valid",
      "tier1-assertion-signature-over-approval-payload-digest-valid",
      "tier1-authority-approval-before-implementation",
      "tier1-assertion-correction-append-only",
      "source-verbatim-to-assertion-authority-approval-required",
      "assertion-acceptance-predicate-equal",
      "assertion-acceptance-product-equal",
      "assertion-acceptance-surface-equal",
      "assertion-acceptance-surface-class-equal",
      "acceptance-applicability-superset",
      "acceptance-visitor-visible-nonweakening",
      "acceptance-painted-applicability-nonweakening",
      "production-acceptance-product-equal",
      "production-acceptance-surface-equal",
      "production-acceptance-surface-class-equal",
      "production-acceptance-predicate-equal",
      "production-acceptance-applicability-equal",
      "evidence-acceptance-product-equal",
      "evidence-acceptance-surface-equal",
      "evidence-acceptance-surface-class-equal",
      "evidence-acceptance-predicate-equal",
      "evidence-acceptance-applicability-equal",
      "rendered-test-acceptance-product-equal",
      "rendered-test-acceptance-surface-equal",
      "rendered-test-acceptance-predicate-equal",
      "rendered-test-acceptance-applicability-equal",
      "rendered-test-observed-after-implementation-start",
      "knowledge-selection-id-unique-across-kinds",
      "knowledge-selection-revision-immutable",
      "knowledge-selection-revision-not-branch-ref",
      "knowledge-selection-gap-unbound-prohibited",
      "knowledge-selection-before-implementation",
      "supersession-target-exists",
      "supersession-graph-acyclic"
    ]
  },
  "x-datarim-canonicalization": {
    "algorithm": "RFC8785",
    "scheme": "JCS",
    "encoding": "UTF-8",
    "unicode_normalization": "NONE",
    "object_member_order": "RFC8785_UTF16_CODE_UNIT_LEXICOGRAPHIC",
    "array_order": {
      "default": "PRESERVE_INPUT_ORDER",
      "sorted_set_like_fields": [
        {
          "payload": "sourceRemark",
          "field": "requirement_ids",
          "order": "ASCENDING_UNICODE_CODE_POINT"
        }
      ]
    },
    "digest_input": "RFC8785_CANONICAL_JSON_UTF8_BYTES_WITHOUT_DIGEST_PREFIX"
  },
  "x-datarim-signature-contract": {
    "algorithm": "ED25519",
    "signed_field": "authority_approval.approval_payload_digest",
    "digest_framing": {
      "strip_prefix": "sha256:",
      "hex_pattern": "^[0-9a-f]{64}$",
      "decode": "LOWERCASE_HEX",
      "signed_message": "RAW_SHA256_DIGEST_BYTES",
      "signed_message_length_bytes": 32
    },
    "signature_framing": {
      "field": "authority_approval.signature",
      "strip_prefix": "ed25519:",
      "decode": "RFC4648_STANDARD_BASE64",
      "canonical_padding": "REQUIRED",
      "decoded_length_bytes": 64
    },
    "public_key_resolution": {
      "reference_field": "authority_approval.key_id",
      "key_type": "ED25519_PUBLIC_KEY",
      "encoding": "RFC4648_STANDARD_BASE64",
      "canonical_padding": "REQUIRED",
      "decoded_length_bytes": 32
    },
    "verification_enforcer": "customer-delivery-validator"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requirement_set_id", "created_at", "source_remarks", "requirements"],
  "properties": {
    "schema_version": { "const": 1 },
    "requirement_set_id": { "type": "string", "pattern": "^reqset-[0-9]{4}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_remarks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceRemark" }
    },
    "requirements": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^req-[0-9]{4}$": { "$ref": "#/$defs/requirement" }
      }
    }
  },
  "$defs": {
    "sourceRemark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision",
        "source_digest",
        "authority_approval",
        "source_tier",
        "verbatim_quote",
        "captured_at",
        "requirement_ids",
        "tier1_assertions"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^source-[0-9]{4}$" },
        "revision": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "source_digest": {
          "description": "SHA-256 over the RFC 8785 canonical JSON UTF-8 bytes of source_id, revision, source_tier, verbatim_quote, captured_at, requirement_ids sorted in ascending Unicode code-point order, optional locale/source_ref, and optional supersedes_source_digest. RFC 8785 performs no Unicode normalization. The sha256: prefix is not part of the digest input.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "authority_approval": { "$ref": "#/$defs/authorityApproval" },
        "supersedes_source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_tier": {
          "enum": ["CUSTOMER_VERBATIM", "AUTHORIZED_RELAY_VERBATIM", "OPERATOR_VERBATIM"]
        },
        "verbatim_quote": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
        "captured_at": { "type": "string", "format": "date-time" },
        "source_ref": { "type": "string", "minLength": 1 },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^req-[0-9]{4}$" }
        },
        "tier1_assertions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/tier1Assertion" }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "tier1_assertion_ids", "acceptance"],
      "properties": {
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^source-[0-9]{4}$" }
        },
        "tier1_assertion_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^assertion-[0-9]{4}$" }
        },
        "paraphrase": {
          "description": "Optional non-authoritative explanatory wording; it never replaces a source-owned Tier-1 assertion.",
          "type": "string",
          "minLength": 1
        },
        "acceptance": { "$ref": "#/$defs/acceptanceTuple" }
      }
    },
    "tier1Assertion": {
      "description": "An authoritative structured assertion owned by its containing Tier-1 source remark. Acceptance may preserve or strengthen it but never replace or weaken it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "revision",
        "source_digest",
        "assertion_digest",
        "authority_approval",
        "requirement_id",
        "predicate_id",
        "product",
        "surface",
        "surface_class",
        "applicability",
        "visitor_visible",
        "asserted_at"
      ],
      "properties": {
        "assertion_id": { "type": "string", "pattern": "^assertion-[0-9]{4}$" },
        "revision": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "assertion_digest": {
          "description": "SHA-256 over the RFC 8785 canonical JSON UTF-8 bytes of every assertion field except assertion_digest and authority_approval. RFC 8785 performs no Unicode normalization. The sha256: prefix is not part of the digest input.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "authority_approval": { "$ref": "#/$defs/authorityApproval" },
        "requirement_id": { "type": "string", "pattern": "^req-[0-9]{4}$" },
        "predicate_id": { "type": "string", "pattern": "^predicate-[a-z0-9][a-z0-9-]*$" },
        "product": { "$ref": "#/$defs/productIdentity" },
        "surface": { "$ref": "#/$defs/surfaceIdentity" },
        "surface_class": { "$ref": "#/$defs/surfaceClass" },
        "applicability": { "$ref": "#/$defs/applicability" },
        "visitor_visible": { "type": "boolean" },
        "asserted_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "visitor_visible": { "const": true } },
            "required": ["visitor_visible"]
          },
          "then": { "properties": { "surface_class": { "const": "VISITOR_VISIBLE" } } },
          "else": { "properties": { "surface_class": { "const": "ENABLING" } } }
        }
      ]
    },
    "authorityApproval": {
      "description": "An authority approval whose ED25519 signature framing is defined exactly by the top-level x-datarim-signature-contract annotation. The approval payload contains approved_digest, authority_id, authority_role, approved_at, evidence_ref, algorithm, and key_id; approval_payload_digest and signature are excluded. Cryptographic verification is enforced by the registered validator.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_digest",
        "authority_id",
        "authority_role",
        "approved_at",
        "evidence_ref",
        "algorithm",
        "key_id",
        "approval_payload_digest",
        "signature"
      ],
      "properties": {
        "approved_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "authority_id": { "type": "string", "pattern": "^authority-[a-z0-9][a-z0-9-]*$" },
        "authority_role": { "enum": ["CUSTOMER", "OPERATOR"] },
        "approved_at": { "type": "string", "format": "date-time" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "algorithm": { "const": "ED25519" },
        "key_id": {
          "description": "Resolves according to x-datarim-signature-contract to an RFC 4648 standard-base64 encoded raw 32-byte Ed25519 public key.",
          "type": "string",
          "pattern": "^key-[a-z0-9][a-z0-9-]*$"
        },
        "approval_payload_digest": {
          "description": "SHA-256 over the RFC 8785 canonical JSON UTF-8 bytes of approved_digest, authority_id, authority_role, approved_at, evidence_ref, algorithm, and key_id. The signed-message wire framing is defined by x-datarim-signature-contract.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature": {
          "description": "The prefixed RFC 4648 standard-base64 Ed25519 signature encoded exactly as defined by x-datarim-signature-contract.",
          "type": "string",
          "pattern": "^ed25519:[A-Za-z0-9+/]{85}[AQgw]==$"
        }
      }
    },
    "acceptanceTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier1_assertion_id",
        "predicate_id",
        "exact_source_quotes",
        "product",
        "surface",
        "surface_class",
        "applicability",
        "before_state",
        "after_state",
        "evidence",
        "knowledge_selection",
        "implementation",
        "visitor_visible",
        "disposition"
      ],
      "properties": {
        "tier1_assertion_id": { "type": "string", "pattern": "^assertion-[0-9]{4}$" },
        "predicate_id": { "type": "string", "pattern": "^predicate-[a-z0-9][a-z0-9-]*$" },
        "exact_source_quotes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceQuote" }
        },
        "product": { "$ref": "#/$defs/productIdentity" },
        "surface": { "$ref": "#/$defs/surfaceIdentity" },
        "surface_class": { "$ref": "#/$defs/surfaceClass" },
        "applicability": { "$ref": "#/$defs/applicability" },
        "before_state": { "type": "string", "minLength": 1 },
        "after_state": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidencePlan" },
        "knowledge_selection": { "$ref": "#/$defs/knowledgeSelection" },
      "implementation": { "$ref": "#/$defs/implementationScope" },
      "visitor_visible": { "type": "boolean" },
      "rendered_test_evidence": { "$ref": "#/$defs/renderedTestEvidence" },
      "production_assertion": { "$ref": "#/$defs/productionAssertion" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "superseded_by": { "type": "string", "pattern": "^req-[0-9]{4}$" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "visitor_visible": { "const": true } },
            "required": ["visitor_visible"]
          },
          "then": {
            "required": ["rendered_test_evidence", "production_assertion"],
            "properties": {
              "evidence": {
                "properties": {
                  "evidence_class": { "const": "VISITOR_VISIBLE_PRODUCTION" }
                }
              }
            }
          },
          "else": {
            "allOf": [
              { "not": { "required": ["rendered_test_evidence"] } },
              { "not": { "required": ["production_assertion"] } }
            ],
            "properties": {
              "evidence": {
                "properties": {
                  "evidence_class": { "const": "NON_VISITOR" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "superseded" } },
            "required": ["disposition"]
          },
          "then": { "required": ["superseded_by"] },
          "else": { "not": { "required": ["superseded_by"] } }
        },
        {
          "if": {
            "properties": { "visitor_visible": { "const": true } },
            "required": ["visitor_visible"]
          },
          "then": { "properties": { "surface_class": { "const": "VISITOR_VISIBLE" } } },
          "else": { "properties": { "surface_class": { "const": "ENABLING" } } }
        }
      ]
    },
    "sourceQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "verbatim_quote"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^source-[0-9]{4}$" },
        "verbatim_quote": { "type": "string", "minLength": 1 }
      }
    },
    "productIdentity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "surfaceIdentity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "surfaceClass": {
      "enum": ["VISITOR_VISIBLE", "ENABLING"]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locales", "viewports", "themes", "painted_matrix_applicable"],
      "properties": {
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["mobile", "desktop"] }
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["light", "dark"] }
        },
        "painted_matrix_applicable": { "type": "boolean" },
        "not_applicable_reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "painted_matrix_applicable": { "const": false } },
            "required": ["painted_matrix_applicable"]
          },
          "then": { "required": ["not_applicable_reason"] },
          "else": { "not": { "required": ["not_applicable_reason"] } }
        }
      ]
    },
    "evidencePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "owner", "evidence_class"],
      "properties": {
        "method": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "$ref": "#/$defs/visitorEvidenceMethod" }
          ]
        },
        "owner": { "type": "string", "minLength": 1 },
        "evidence_class": { "enum": ["VISITOR_VISIBLE_PRODUCTION", "NON_VISITOR"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "evidence_class": { "const": "VISITOR_VISIBLE_PRODUCTION" } },
            "required": ["evidence_class"]
          },
          "then": {
            "properties": { "method": { "$ref": "#/$defs/visitorEvidenceMethod" } }
          },
          "else": {
            "properties": { "method": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "identityApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locales", "viewports", "themes", "painted_matrix_applicable"],
      "properties": {
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" }
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["mobile", "desktop"] }
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["light", "dark"] }
        },
        "painted_matrix_applicable": { "type": "boolean" }
      }
    },
    "visitorEvidenceMethod": {
      "description": "A closed rendered-production evidence identity. Documentation, tests, tools, CI, ledgers, URLs, and arbitrary prose are not authoritative visitor evidence fields.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "product", "surface", "surface_class", "predicate_id", "applicability", "environment"],
      "properties": {
        "kind": {
          "enum": [
            "BROWSER_AUTOMATION",
            "PAINTED_SURFACE_PROBE",
            "RENDERED_SCREENSHOT_REVIEW"
          ]
        },
        "product": { "$ref": "#/$defs/productIdentity" },
        "surface": { "$ref": "#/$defs/surfaceIdentity" },
        "surface_class": { "$ref": "#/$defs/surfaceClass" },
        "predicate_id": { "type": "string", "pattern": "^predicate-[a-z0-9][a-z0-9-]*$" },
        "applicability": { "$ref": "#/$defs/identityApplicability" },
        "environment": { "const": "PRODUCTION" }
      }
    },
    "renderedTestEvidence": {
      "description": "Mandatory supporting rendered TEST evidence for visitor-visible acceptance; it cannot replace the production assertion or live receipt evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "product",
        "surface",
        "predicate_id",
        "applicability",
        "baseline_ref",
        "candidate_ref",
        "observed_at",
        "owner"
      ],
      "properties": {
        "environment": { "const": "TEST" },
        "product": { "$ref": "#/$defs/productIdentity" },
        "surface": { "$ref": "#/$defs/surfaceIdentity" },
        "predicate_id": { "type": "string", "pattern": "^predicate-[a-z0-9][a-z0-9-]*$" },
        "applicability": { "$ref": "#/$defs/identityApplicability" },
        "baseline_ref": { "type": "string", "minLength": 1 },
        "candidate_ref": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "productionAssertion": {
      "description": "A closed visitor-observation identity bound to the source-owned predicate and accepted production scope, not an enabling artifact or prose claim.",
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "environment", "observation_kind", "product", "surface", "surface_class", "predicate_id", "applicability"],
      "properties": {
        "actor": { "const": "VISITOR" },
        "environment": { "const": "PRODUCTION" },
        "observation_kind": {
          "enum": ["BROWSER_RENDERED", "PAINTED_SURFACE", "RENDERED_SCREENSHOT"]
        },
        "product": { "$ref": "#/$defs/productIdentity" },
        "surface": { "$ref": "#/$defs/surfaceIdentity" },
        "surface_class": { "$ref": "#/$defs/surfaceClass" },
        "predicate_id": { "type": "string", "pattern": "^predicate-[a-z0-9][a-z0-9-]*$" },
        "applicability": { "$ref": "#/$defs/identityApplicability" }
      }
    },
    "knowledgeSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles", "skills", "blueprints", "constraints", "policies", "success_criteria"],
      "properties": {
        "roles": { "$ref": "#/$defs/pinnedKnowledgeList" },
        "skills": { "$ref": "#/$defs/pinnedKnowledgeList" },
        "blueprints": { "$ref": "#/$defs/pinnedKnowledgeList" },
        "constraints": { "$ref": "#/$defs/pinnedKnowledgeList" },
        "policies": { "$ref": "#/$defs/pinnedKnowledgeList" },
        "success_criteria": { "$ref": "#/$defs/pinnedKnowledgeList" }
      }
    },
    "pinnedKnowledgeList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pinnedKnowledge" }
    },
    "pinnedKnowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "digest", "selected_at", "selected_before_implementation", "immutable"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "selected_at": { "type": "string", "format": "date-time" },
        "selected_before_implementation": { "const": true },
        "immutable": { "const": true }
      }
    },
    "implementationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "code_revision", "content_revision", "code_paths", "content_paths", "environment", "started_at"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^task:[a-z][a-z0-9-]*:[0-9]{4}$" },
        "code_revision": { "type": "string", "minLength": 1 },
        "content_revision": { "type": "string", "minLength": 1 },
        "code_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "content_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "environment": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "format": "date-time" }
      },
      "anyOf": [
        { "properties": { "code_paths": { "minItems": 1 } } },
        { "properties": { "content_paths": { "minItems": 1 } } }
      ]
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "disposition": {
      "enum": ["pending", "accepted", "rejected", "superseded"]
    }
  }
}
